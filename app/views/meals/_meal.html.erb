<%= turbo_frame_tag meal do %>
  <div class="meal__card">
    <div class="meal__card__header">
      <%= link_to meal.name, 
                  meal_path(meal),
                  data: { turbo_frame: "_top" } %>
      <%= link_to meal.user.name, 
                  user_meals_path(meal.user),
                  data: { turbo_frame: "_top" } %>
    </div>
    <div class="meal__card__image">
      <% if meal.image.attached? %>
        <%= image_tag meal.image.variant(resize_to_fill: [500, 500, crop: :centre]).processed %>
      <% else %>
        <%= "No image available" %>
      <% end %>
    </div>
    <div class="meal__card__info">
      <div class="meal__card__info_column">
        <div class="">
          <%= "Portions: #{meal.portions}" %>
        </div>
      </div>
      <div class="meal__card__info_column">
        <div class="">
          <%= "Calories: #{meal.calories_per_portion}" %>
        </div>
        <div class="">
          <%= "Protein: #{meal.protein_per_portion}g" %>
        </div>
      </div>

      <div class="meal__card__info_column">
        <div class="">
          <%= "Carbohydrates: #{meal.carbohydrates_per_portion}g" %>
        </div>
        <div class="">
          <%= "Fat: #{meal.saturated_fat_per_portion + meal.unsaturated_fat_per_portion}g" %>
        </div>
      </div>


      <div class="meal__card__info_column">
        <div class="">
          <%= "Fibre: #{meal.fibre_per_portion}g" %>
        </div>
        <div class="">
          <%= "Salt: #{meal.salt_per_portion}g" %>
        </div>
      </div>
    </div>
    <div class="meal__card__footer">
      Posted: <%= formatted_post_date(meal.created_at) %>
    </div>
  </div>
<% end %>