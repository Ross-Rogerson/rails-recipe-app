<main class="container">
  <%= link_to sanitize("&larr; Back to meals"), meals_path %>
  <%= turbo_frame_tag @meal do %>
    <div class="show__header">
      <h1>
        <%= @meal.name %>
      </h1>
      <% if current_user == @meal.user %>
        <div class="show__actions">
          <%= link_to "Edit",
                      edit_meal_path,
                      class: "btn btn--light" %>
          <%= button_to "Delete",
                        meal_path(@meal),
                        method: :delete,
                        data: { turbo_frame: "_top" },
                        class: "btn btn--light" %>
        </div>
      <% end %>
    </div>

    <div class="show__body">
      <div class="show__meal-subheading">
        <h4>Meal Nutrition</h4>
      </div>
      
      <% nutrition_labels.each do |key, label| %>
        <div class="show__meal-nutrition-value">
          <%= "#{label}: #{@meal.public_send(key)}" %>
        </div>
      <% end %>

      <div class="show__meal-subheading">
        <h4>Ingredients</h4>
      </div>
      <% @meal.meal_ingredients.each do |meal_ingredient| %>
        <div class="show__meal-ingredient">
          <%= meal_ingredient_display_name(meal_ingredient) %>
        </div>
      <% end %>
    </div>
  <% end %>
</main>